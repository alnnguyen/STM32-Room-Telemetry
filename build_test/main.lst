  89:Core/Src/main.c ****   MX_I2C1_Init();
  90:Core/Src/main.c **** 
  91:Core/Src/main.c ****   /* USER CODE BEGIN 2 */
  92:Core/Src/main.c **** #ifdef SENSOR_TEST
  93:Core/Src/main.c ****   sensor_test_run(); // never returns; see sensor_test.c
  94:Core/Src/main.c **** #endif
  95:Core/Src/main.c **** 
  96:Core/Src/main.c ****   uint32_t counter = 0;
  97:Core/Src/main.c ****   /* USER CODE END 2 */
  98:Core/Src/main.c **** 
  99:Core/Src/main.c ****   /* Infinite loop */
 100:Core/Src/main.c ****   /* USER CODE BEGIN WHILE */
 101:Core/Src/main.c **** 
 102:Core/Src/main.c ****   while (1) {
 103:Core/Src/main.c ****     /* USER CODE END WHILE */
 104:Core/Src/main.c **** 
 105:Core/Src/main.c ****     /* USER CODE BEGIN 3 */
 106:Core/Src/main.c ****     HAL_GPIO_TogglePin(LD2_GPIO_Port, LD2_Pin);
 107:Core/Src/main.c **** 
 108:Core/Src/main.c ****     uint8_t response[6] = {0};
 109:Core/Src/main.c ****     uint8_t command[2] = {0x24, 0x00};
 110:Core/Src/main.c **** 
 111:Core/Src/main.c ****     // Declare sensory status variable
 112:Core/Src/main.c ****     HAL_StatusTypeDef sensor_status;
 113:Core/Src/main.c **** 
 114:Core/Src/main.c ****     // Transmit into sensor status, sends byte from stm to sensor
 115:Core/Src/main.c ****     sensor_status = HAL_I2C_Master_Transmit(&hi2c1, (0x44U << 1), command,
 116:Core/Src/main.c ****                                             sizeof(command), 100U);
 117:Core/Src/main.c **** 
 118:Core/Src/main.c ****     // If fail then wait and go again
 119:Core/Src/main.c ****     if (sensor_status != HAL_OK) {
 120:Core/Src/main.c ****       HAL_Delay(HEARTBEAT_PERIOD_MS);
 121:Core/Src/main.c ****       continue;
 122:Core/Src/main.c ****     }
 123:Core/Src/main.c **** 
 124:Core/Src/main.c ****     HAL_Delay(20);
 125:Core/Src/main.c **** 
 126:Core/Src/main.c ****     // Sensor sends back data to stm
 127:Core/Src/main.c ****     sensor_status = HAL_I2C_Master_Receive(&hi2c1, (0x44U << 1), response,
 128:Core/Src/main.c ****                                            sizeof(response), 100U);
 129:Core/Src/main.c ****     // Sensor sends each value as two bytes, we shift high byte then or to get
 130:Core/Src/main.c ****     // full 16 bit value
 131:Core/Src/main.c ****     uint16_t t_raw = ((uint16_t)response[0] << 8) | response[1];
 132:Core/Src/main.c ****     uint16_t h_raw = ((uint16_t)response[3] << 8) | response[4];
 133:Core/Src/main.c **** 
 134:Core/Src/main.c ****     // Convert to real units
 135:Core/Src/main.c ****     int32_t temp_c100 = -4500 + (int32_t)(17500UL * t_raw / 65535UL);
 136:Core/Src/main.c ****     int32_t rh100 = (int32_t)(10000UL * h_raw / 65535UL);
 137:Core/Src/main.c **** 
 138:Core/Src/main.c ****     char message[64]; // declared empty message aray 64 bytes wide
 139:Core/Src/main.c **** 
 140:Core/Src/main.c ****     // turns the counter into text while respecting the buffer size.
 141:Core/Src/main.c **** 
 142:Core/Src/main.c ****     // Print temp reading
 143:Core/Src/main.c ****     int length;
 144:Core/Src/main.c ****     if (sensor_status == HAL_OK) {
 145:Core/Src/main.c ****       length = snprintf(message, sizeof(message),
ARM GAS  /var/folders/y2/vcd__b_j7t36kd05mb3jp2l80000gn/T//ccdVndzv.s 			page 4


 146:Core/Src/main.c ****                         "Sample %lu: T=%ld.%02ld C RH=%ld.%02ld %%\r\n",
 147:Core/Src/main.c ****                         (unsigned long)counter, (long)(temp_c100 / 100),
 148:Core/Src/main.c ****                         (long)labs(temp_c100 % 100), (long)(rh100 / 100),
 149:Core/Src/main.c ****                         (long)(rh100 % 100));
 150:Core/Src/main.c ****     } else {
 151:Core/Src/main.c ****       length = snprintf(message, sizeof(message), "Sample %lu: read failed\r\n",
 152:Core/Src/main.c ****                         (unsigned long)counter);
 153:Core/Src/main.c ****     }
 154:Core/Src/main.c **** 
 155:Core/Src/main.c ****     if (length > 0 && (size_t)length < sizeof(message)) {
 156:Core/Src/main.c ****       HAL_StatusTypeDef status = HAL_UART_Transmit(
 157:Core/Src/main.c ****           &huart2,
 158:Core/Src/main.c ****           (uint8_t *)message, // HAL_UART_Transmit, first arg is settings and
 159:Core/Src/main.c ****                               // state strcut for usart2 (baud rate, which pins,
 160:Core/Src/main.c ****                               // passes pointer, 2nd is pointer to the data)
 161:Core/Src/main.c ****           (uint16_t)length,
 162:Core/Src/main.c ****           UART_TIMEOUT_MS); // 3rd is how many bytes to send, type cast for
 163:Core/Src/main.c ****                             // bytes, give up after 100ms
 164:Core/Src/main.c **** 
 165:Core/Src/main.c ****       if (status != HAL_OK) {
 166:Core/Src/main.c ****         Error_Handler();
 167:Core/Src/main.c ****       }
 168:Core/Src/main.c ****     }
 169:Core/Src/main.c **** 
 170:Core/Src/main.c ****     counter++;
 171:Core/Src/main.c ****     HAL_Delay(HEARTBEAT_PERIOD_MS);
 172:Core/Src/main.c ****   }
 173:Core/Src/main.c ****   /* USER CODE END 3 */
 174:Core/Src/main.c **** }
