  87:Core/Src/main.c **** /* Preserve the peripheral-reset recovery used during bring-up.
  88:Core/Src/main.c ****  * This cannot fix missing power, loose wires or a device holding SDA low.
ARM GAS  /var/folders/y2/vcd__b_j7t36kd05mb3jp2l80000gn/T//cckonbfQ.s 			page 3


  89:Core/Src/main.c ****  */
  90:Core/Src/main.c **** static void recover_i2c1(void) {
  91:Core/Src/main.c ****   HAL_StatusTypeDef status = HAL_I2C_DeInit(&hi2c1);
  92:Core/Src/main.c ****   if (status == HAL_OK) {
  93:Core/Src/main.c ****     __HAL_RCC_I2C1_FORCE_RESET();
  94:Core/Src/main.c ****     __HAL_RCC_I2C1_RELEASE_RESET();
  95:Core/Src/main.c ****     status = HAL_I2C_Init(&hi2c1);
  96:Core/Src/main.c ****   }
  97:Core/Src/main.c ****   if (status != HAL_OK) {
  98:Core/Src/main.c ****     static const char message[] =
  99:Core/Src/main.c ****         "I2C1 recovery failed; retrying next sample\r\n";
 100:Core/Src/main.c ****     uart_send(message, sizeof(message) - 1U);
 101:Core/Src/main.c ****   }
 102:Core/Src/main.c **** }
 103:Core/Src/main.c **** 
 104:Core/Src/main.c **** static void report_sample(uint32_t counter, SHT31_Status status,
 105:Core/Src/main.c ****                           const SHT31_Reading *reading) {
 106:Core/Src/main.c ****   char message[96];
 107:Core/Src/main.c ****   int length;
 108:Core/Src/main.c **** 
 109:Core/Src/main.c ****   if (status == SHT31_OK) {
 110:Core/Src/main.c ****     /* The sign is separate so -50 hundredths prints as -0.50, not 0.50. */
 111:Core/Src/main.c ****     long temperature = (long)reading->temperature_f100;
 112:Core/Src/main.c ****     long magnitude = labs(temperature);
 113:Core/Src/main.c ****     long humidity = (long)reading->humidity_rh100;
 114:Core/Src/main.c **** 
 115:Core/Src/main.c ****     length = snprintf(message, sizeof(message),
 116:Core/Src/main.c ****                       "Sample %lu: T=%s%ld.%02ld F RH=%ld.%02ld %% CRC=OK\r\n",
 117:Core/Src/main.c ****                       (unsigned long)counter, temperature < 0 ? "-" : "",
 118:Core/Src/main.c ****                       magnitude / 100L, magnitude % 100L, humidity / 100L,
 119:Core/Src/main.c ****                       humidity % 100L);
 120:Core/Src/main.c ****   } else {
 121:Core/Src/main.c ****     length = snprintf(message, sizeof(message), "Sample %lu: SHT31 %s\r\n",
 122:Core/Src/main.c ****                       (unsigned long)counter, SHT31_StatusText(status));
 123:Core/Src/main.c ****   }
 124:Core/Src/main.c **** 
 125:Core/Src/main.c ****   if (length > 0 && (size_t)length < sizeof(message)) {
 126:Core/Src/main.c ****     uart_send(message, (size_t)length);
 127:Core/Src/main.c ****   }
 128:Core/Src/main.c **** }
 129:Core/Src/main.c **** 
