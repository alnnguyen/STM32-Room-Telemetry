  45:Core/Src/sensor_test.c **** // A stuck bus (error 0x20 / 0x200) needs the peripheral reset to recover
  46:Core/Src/sensor_test.c **** // (STM32F4 quirk: the BUSY flag can latch after a glitch and only a peripheral
  47:Core/Src/sensor_test.c **** // reset clears it, so pulse the RCC reset line, not just DeInit/Init.)
  48:Core/Src/sensor_test.c **** static void i2c_recover(void) {
