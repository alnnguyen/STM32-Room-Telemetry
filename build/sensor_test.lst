   1:Core/Src/sensor_test.c **** /*
   2:Core/Src/sensor_test.c ****  * Standalone SHT31 bring-up test. Only runs when built with -DSENSOR_TEST
   3:Core/Src/sensor_test.c ****  * (see main.c, USER CODE BEGIN 2). Never returns.
   4:Core/Src/sensor_test.c ****  *
   5:Core/Src/sensor_test.c ****  * Every second it prints:
   6:Core/Src/sensor_test.c ****  *   1. every I2C address that ACKs (bus scan)
   7:Core/Src/sensor_test.c ****  *   2. a full SHT31 reading with CRC check, or exactly which step failed
   8:Core/Src/sensor_test.c ****  */
   9:Core/Src/sensor_test.c **** #include "main.h"
  10:Core/Src/sensor_test.c **** #include <stdarg.h>
  11:Core/Src/sensor_test.c **** #include <stdio.h>
  12:Core/Src/sensor_test.c **** #include <stdlib.h>
  13:Core/Src/sensor_test.c **** 
  14:Core/Src/sensor_test.c **** extern I2C_HandleTypeDef hi2c1;
  15:Core/Src/sensor_test.c **** extern UART_HandleTypeDef huart2;
  16:Core/Src/sensor_test.c **** 
  17:Core/Src/sensor_test.c **** #define SHT31_ADDR (0x44U << 1)
  18:Core/Src/sensor_test.c **** 
  19:Core/Src/sensor_test.c **** static void out(const char *fmt, ...) {
  20:Core/Src/sensor_test.c ****   char buf[96];
  21:Core/Src/sensor_test.c ****   va_list ap;
  22:Core/Src/sensor_test.c ****   va_start(ap, fmt);
  23:Core/Src/sensor_test.c ****   int n = vsnprintf(buf, sizeof(buf), fmt, ap);
  24:Core/Src/sensor_test.c ****   va_end(ap);
  25:Core/Src/sensor_test.c ****   if (n > 0) {
  26:Core/Src/sensor_test.c ****     if ((size_t)n >= sizeof(buf)) {
  27:Core/Src/sensor_test.c ****       n = sizeof(buf) - 1;
  28:Core/Src/sensor_test.c ****     }
  29:Core/Src/sensor_test.c ****     HAL_UART_Transmit(&huart2, (uint8_t *)buf, (uint16_t)n, 100U);
  30:Core/Src/sensor_test.c ****   }
