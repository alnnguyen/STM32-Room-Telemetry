  93:Core/Src/ssd1306.c **** HAL_StatusTypeDef SSD1306_Init(I2C_HandleTypeDef *i2c) {
  94:Core/Src/ssd1306.c ****   /* Standard power-up sequence for a 128x64 panel with its charge pump. */
  95:Core/Src/ssd1306.c ****   static const uint8_t init_sequence[] = {
  96:Core/Src/ssd1306.c ****       0xAE,       /* display off while configuring */
  97:Core/Src/ssd1306.c ****       0xD5, 0x80, /* clock divide / oscillator frequency */
  98:Core/Src/ssd1306.c ****       0xA8, 0x3F, /* multiplex ratio: 64 rows */
  99:Core/Src/ssd1306.c ****       0xD3, 0x00, /* display offset: none */
