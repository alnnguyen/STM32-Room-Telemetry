 100:Core/Src/ssd1306.c ****       0x40,       /* start line = 0 */
 101:Core/Src/ssd1306.c ****       0x8D, 0x14, /* enable the internal charge pump (runs from 3.3 V) */
 102:Core/Src/ssd1306.c ****       0x20, 0x00, /* horizontal addressing mode */
 103:Core/Src/ssd1306.c ****       0xA1,       /* flip columns so x=0 is on the left */
 104:Core/Src/ssd1306.c ****       0xC8,       /* flip rows so y=0 is at the top */
 105:Core/Src/ssd1306.c ****       0xDA, 0x12, /* COM pin layout for 128x64 */
