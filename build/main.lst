  88:Core/Src/main.c **** /* Preserve the peripheral-reset recovery used during bring-up.
ARM GAS  /var/folders/y2/vcd__b_j7t36kd05mb3jp2l80000gn/T//cciXU1KJ.s 			page 3


  89:Core/Src/main.c ****  * This cannot fix missing power, loose wires or a device holding SDA low.
  90:Core/Src/main.c ****  */
  91:Core/Src/main.c **** static void recover_i2c1(void) {
  92:Core/Src/main.c ****   HAL_StatusTypeDef status = HAL_I2C_DeInit(&hi2c1);
  93:Core/Src/main.c ****   if (status == HAL_OK) {
  94:Core/Src/main.c ****     __HAL_RCC_I2C1_FORCE_RESET();
  95:Core/Src/main.c ****     __HAL_RCC_I2C1_RELEASE_RESET();
  96:Core/Src/main.c ****     status = HAL_I2C_Init(&hi2c1);
  97:Core/Src/main.c ****   }
  98:Core/Src/main.c ****   if (status != HAL_OK) {
  99:Core/Src/main.c ****     static const char message[] =
 100:Core/Src/main.c ****         "I2C1 recovery failed; retrying next sample\r\n";
 101:Core/Src/main.c ****     uart_send(message, sizeof(message) - 1U);
 102:Core/Src/main.c ****   }
 103:Core/Src/main.c **** }
 104:Core/Src/main.c **** 
 105:Core/Src/main.c **** static void report_sample(uint32_t counter, SHT31_Status status,
 106:Core/Src/main.c ****                           const SHT31_Reading *reading) {
 107:Core/Src/main.c ****   char message[96];
 108:Core/Src/main.c ****   int length;
 109:Core/Src/main.c **** 
 110:Core/Src/main.c ****   if (status == SHT31_OK) {
 111:Core/Src/main.c ****     /* The sign is separate so -50 hundredths prints as -0.50, not 0.50. */
 112:Core/Src/main.c ****     long temperature = (long)reading->temperature_f100;
 113:Core/Src/main.c ****     long magnitude = labs(temperature);
 114:Core/Src/main.c ****     long humidity = (long)reading->humidity_rh100;
 115:Core/Src/main.c **** 
 116:Core/Src/main.c ****     length = snprintf(message, sizeof(message),
 117:Core/Src/main.c ****                       "Sample %lu: T=%s%ld.%02ld F RH=%ld.%02ld %% CRC=OK\r\n",
 118:Core/Src/main.c ****                       (unsigned long)counter, temperature < 0 ? "-" : "",
 119:Core/Src/main.c ****                       magnitude / 100L, magnitude % 100L, humidity / 100L,
 120:Core/Src/main.c ****                       humidity % 100L);
 121:Core/Src/main.c ****   } else {
 122:Core/Src/main.c ****     length = snprintf(message, sizeof(message), "Sample %lu: SHT31 %s\r\n",
 123:Core/Src/main.c ****                       (unsigned long)counter, SHT31_StatusText(status));
 124:Core/Src/main.c ****   }
 125:Core/Src/main.c **** 
 126:Core/Src/main.c ****   if (length > 0 && (size_t)length < sizeof(message)) {
 127:Core/Src/main.c ****     uart_send(message, (size_t)length);
 128:Core/Src/main.c ****   }
 129:Core/Src/main.c **** }
 130:Core/Src/main.c **** 
 131:Core/Src/main.c **** /* Set once the OLED has answered and initialised; cleared if an update fails,
 132:Core/Src/main.c ****  * so a missing display never slows down or stops the sensor loop.
 133:Core/Src/main.c ****  */
 134:Core/Src/main.c **** static int oled_ready = 0;
 135:Core/Src/main.c **** 
 136:Core/Src/main.c **** /* Draw the latest sample on the OLED. Drawing only fills a RAM buffer;
 137:Core/Src/main.c ****  * SSD1306_Update() is what sends it to the panel over I2C.
 138:Core/Src/main.c ****  */
 139:Core/Src/main.c **** static void oled_show_sample(uint32_t counter, SHT31_Status status,
 140:Core/Src/main.c ****                              const SHT31_Reading *reading) {
 141:Core/Src/main.c ****   char line[24];
 142:Core/Src/main.c **** 
 143:Core/Src/main.c ****   SSD1306_Clear();
 144:Core/Src/main.c ****   SSD1306_DrawText(0, 0, "SHT31 MONITOR");
 145:Core/Src/main.c **** 
ARM GAS  /var/folders/y2/vcd__b_j7t36kd05mb3jp2l80000gn/T//cciXU1KJ.s 			page 4


 146:Core/Src/main.c ****   if (status == SHT31_OK) {
 147:Core/Src/main.c ****     long temperature = (long)reading->temperature_f100;
 148:Core/Src/main.c ****     long magnitude = labs(temperature);
 149:Core/Src/main.c ****     long humidity = (long)reading->humidity_rh100;
 150:Core/Src/main.c **** 
 151:Core/Src/main.c ****     snprintf(line, sizeof(line), "TEMP: %s%ld.%02ld F", temperature < 0 ? "-" : "",
 152:Core/Src/main.c ****              magnitude / 100L, magnitude % 100L);
 153:Core/Src/main.c ****     SSD1306_DrawText(0, 2, line);
 154:Core/Src/main.c ****     snprintf(line, sizeof(line), "HUMID: %ld.%02ld %%", humidity / 100L,
 155:Core/Src/main.c ****              humidity % 100L);
 156:Core/Src/main.c ****     SSD1306_DrawText(0, 3, line);
 157:Core/Src/main.c ****   } else {
 158:Core/Src/main.c ****     SSD1306_DrawText(0, 2, "SENSOR ERROR:");
 159:Core/Src/main.c ****     SSD1306_DrawText(0, 3, SHT31_StatusText(status));
 160:Core/Src/main.c ****   }
 161:Core/Src/main.c **** 
 162:Core/Src/main.c ****   snprintf(line, sizeof(line), "SAMPLE: %lu", (unsigned long)counter);
 163:Core/Src/main.c ****   SSD1306_DrawText(0, 5, line);
 164:Core/Src/main.c **** 
 165:Core/Src/main.c ****   if (SSD1306_Update(&hi2c1) != HAL_OK) {
 166:Core/Src/main.c ****     oled_ready = 0;
 167:Core/Src/main.c ****   }
 168:Core/Src/main.c **** }
 169:Core/Src/main.c **** 
