  99:Core/Src/main.c ****       uint32_t counter = 0;
 100:Core/Src/main.c ****   /* USER CODE END 2 */
 101:Core/Src/main.c **** 
 102:Core/Src/main.c ****   /* Infinite loop */
 103:Core/Src/main.c ****   /* USER CODE BEGIN WHILE */
 104:Core/Src/main.c **** 
 105:Core/Src/main.c ****   while (1) {
 106:Core/Src/main.c ****     /* USER CODE END WHILE */
 107:Core/Src/main.c **** 
 108:Core/Src/main.c ****     /* USER CODE BEGIN 3 */
 109:Core/Src/main.c ****     HAL_GPIO_TogglePin(LD2_GPIO_Port, LD2_Pin);
 110:Core/Src/main.c **** 
 111:Core/Src/main.c ****     HAL_StatusTypeDef sensor_status =
 112:Core/Src/main.c ****         HAL_I2C_IsDeviceReady(&hi2c1, (0x44U << 1), 2U, 100U);
 113:Core/Src/main.c **** 
 114:Core/Src/main.c ****     char message[64]; // declared empty message aray 64 bytes wide
 115:Core/Src/main.c **** 
 116:Core/Src/main.c ****     // turns the counter into text while respecting the buffer size.
 117:Core/Src/main.c **** 
 118:Core/Src/main.c ****     // snprintf writes to a destiantion buffer where its pointed to with first
 119:Core/Src/main.c ****     // arg, size of is size of buffer, sample is what is written It also returns
 120:Core/Src/main.c ****     // total number of characters that would be written or is
 121:Core/Src/main.c ****     int length = snprintf(message, sizeof(message),
 122:Core/Src/main.c ****                           "Sample %lu: I2C 0x44 %s\r\n", (unsigned long)counter,
 123:Core/Src/main.c ****                           sensor_status == HAL_OK ? "ACK" : "no ACK");
 124:Core/Src/main.c **** 
 125:Core/Src/main.c ****     // if lenght is valid, greater than 0 and length is less than the buffer
 126:Core/Src/main.c ****     // meaning nothing was truncated, size_t cast is there becasue lenght is
 127:Core/Src/main.c ****     // signed and size of is unsignged
 128:Core/Src/main.c ****     if (length > 0 && (size_t)length < sizeof(message)) {
 129:Core/Src/main.c ****       HAL_StatusTypeDef status = HAL_UART_Transmit(
 130:Core/Src/main.c ****           &huart2,
 131:Core/Src/main.c ****           (uint8_t *)message, // HAL_UART_Transmit, first arg is settings and
 132:Core/Src/main.c ****                               // state strcut for usart2 (baud rate, which pins,
 133:Core/Src/main.c ****                               // passes pointer, 2nd is pointer to the data)
 134:Core/Src/main.c ****           (uint16_t)length,
 135:Core/Src/main.c ****           UART_TIMEOUT_MS); // 3rd is how many bytes to send, type cast for
 136:Core/Src/main.c ****                             // bytes, give up after 100ms
 137:Core/Src/main.c **** 
 138:Core/Src/main.c ****       if (status != HAL_OK) {
 139:Core/Src/main.c ****         Error_Handler();
 140:Core/Src/main.c ****       }
 141:Core/Src/main.c ****     }
 142:Core/Src/main.c **** 
 143:Core/Src/main.c ****     counter++;
 144:Core/Src/main.c ****     HAL_Delay(HEARTBEAT_PERIOD_MS);
 145:Core/Src/main.c ****   }
