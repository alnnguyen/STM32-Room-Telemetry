 214:Core/Src/main.c ****   HAL_StatusTypeDef oled_status =
 215:Core/Src/main.c ****       HAL_I2C_IsDeviceReady(&hi2c1, (0x3CU << 1), 2U, 100U);
 216:Core/Src/main.c **** 
 217:Core/Src/main.c ****   if (oled_status == HAL_OK) {
 218:Core/Src/main.c ****     const char message[] = "OLED ACK at 0x3C\r\n";
 219:Core/Src/main.c ****     uart_send(message, sizeof(message) - 1U);
 220:Core/Src/main.c ****   } else {
 221:Core/Src/main.c ****     const char message[] = "OLED no ACK at 0x3C\r\n";
 222:Core/Src/main.c ****     uart_send(message, sizeof(message) - 1U);
 223:Core/Src/main.c ****   }
 224:Core/Src/main.c **** 
 225:Core/Src/main.c ****   if (oled_status == HAL_OK && SSD1306_Init(&hi2c1) == HAL_OK) {
 226:Core/Src/main.c ****     oled_ready = 1;
 227:Core/Src/main.c ****     /* TEMP bring-up check: 0xA5 forces every pixel on; 0xA4 returns to RAM. */
 228:Core/Src/main.c ****     SSD1306_SendCommand(&hi2c1, 0xA5);
 229:Core/Src/main.c ****     HAL_Delay(2000U);
 230:Core/Src/main.c ****     SSD1306_SendCommand(&hi2c1, 0xA4);
 231:Core/Src/main.c ****     const char message[] = "OLED init OK\r\n";
 232:Core/Src/main.c ****     uart_send(message, sizeof(message) - 1U);
 233:Core/Src/main.c ****   } else {
 234:Core/Src/main.c ****     const char message[] = "OLED init failed\r\n";
 235:Core/Src/main.c ****     uart_send(message, sizeof(message) - 1U);
 236:Core/Src/main.c ****   }
